{
  "compilerOptions": {
    "module":           "Node16",
    "moduleResolution": "Node16",
    "target":           "ES2022",
    "outDir":           "./out",
    "rootDir":          "./src",
    "lib":              ["ES2022"],
    "strict":           true,
    "esModuleInterop":  true,
    "skipLibCheck":     true,
    "sourceMap":        true,
    "declaration":      true
  },
  "include":  ["src/**/*.ts"],
  "exclude":  ["node_modules", "out"]
}
