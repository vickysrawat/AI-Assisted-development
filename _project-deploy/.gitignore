# Plugin-managed entries ONLY.
# This file contains ONLY what the ai-assisted-development plugin generates and manages.
# It does NOT contain target-codebase entries (build artifacts, IDE files, etc.).
#
# Stack-specific entries (.NET obj/, Angular dist/, node_modules/, etc.) are added
# separately by setup-init / setup-sync based on the detected stack — they are written
# outside the managed block and owned by the developer after that.
#
# Two-pass model:
#   Pass 1 (this file) — plugin managed block, synced by /gitignore-sync on any re-run
#   Pass 2 (stack templates) — one-time addition by setup-init, never overwritten again
#
# === ai-assisted-development (managed) ===

# Claude Code local settings — secrets and machine-specific permissions
.claude/settings.local.json

# Generated checkpoint and cache files (rebuilt on demand)
.claude/security-checkpoint.json
.claude/code-review-checkpoint.json
.claude/file-cache.json
.claude/session-context.json

# Plugin runtime state — regenerated by setup-init / setup-sync
.claude/dream-init-state.json
.claude/plugin-path.txt

# Generated HTML reports (large, rebuilt on demand)
memory/health.html

# Code-review scan output — ignore bulk; keep the ledger (persistent findings record)
CodeReviews/*
!CodeReviews/code-review-ledger.md

# Security scan output — ignore bulk; keep the ledger
security/*
!security/security-ledger.md

# Dynamic/DAST scan output — ignore bulk; keep the ledger
dynamic-scan/*
!dynamic-scan/dynamic-scan-ledger.md

# Token analysis HTML reports (rebuilt on demand)
token-analysis/

# Production readiness reports (rebuilt on demand)
prod-readiness/

# Temp staging area for ICEA / Tech Spec drafts — never committed
temp/

# === end ai-assisted-development ===


# ── Optional plugin entries — uncomment per project preference ─────────────────

# Release metrics reports — generated by METRICS RELEASE-{N}
# Commit to preserve release records, or ignore to treat as generated output.
# release-metrics/

# Graph visualisation HTML — rebuilt by /graph-viz
# .claude/graph/graph.html
