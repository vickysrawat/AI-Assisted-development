<?xml version="1.0" encoding="utf-8"?>
<!-- Fixture: on-prem IIS app. Signals: Windows auth, SQL Server, file share, MSMQ. -->
<configuration>
  <connectionStrings>
    <add name="OrdersDb" connectionString="Server=ONPREM-SQL01;Database=Orders;Integrated Security=SSPI;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="InvoiceShare" value="\\FILESRV01\invoices" />
    <add key="OrderQueue" value=".\private$\orders" />
  </appSettings>
  <system.web>
    <authentication mode="Windows" />
    <compilation targetFramework="4.8" />
  </system.web>
</configuration>
