<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- When true, purchase orders at or above the auto-approve ceiling are
         auto-approved without a manager. When false they require a manager.
         This flag is environment-specific and is overridden in production. -->
    <add key="AutoApproveEnabled" value="false" />
    <!-- Auto-approve ceiling in dollars. Orders strictly below this amount
         may be auto-approved when AutoApproveEnabled is true. -->
    <add key="AutoApproveCeiling" value="5000" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*"
           type="System.Web.Handlers.TransferRequestHandler"
           preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
</configuration>
